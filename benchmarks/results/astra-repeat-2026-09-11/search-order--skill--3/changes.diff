+import asyncio
+import unittest
+
+from search import Search
+
+
+class SearchInteractionTests(unittest.IsolatedAsyncioTestCase):
+    async def exercise_response_order(self, completion_order, latest_result):
+        search = Search()
+        queries = ("ca", "cat")
+        loop = asyncio.get_running_loop()
+        responses = {query: loop.create_future() for query in queries}
+        started = {query: asyncio.Event() for query in queries}
+        results = {"ca": ["car"], "cat": latest_result}
+
+        async def fetch(query):
+            started[query].set()
+            return await responses[query]
+
+        tasks = {}
+        try:
+            # Type a query, then refine it while its request is still pending.
+            for query in queries:
+                tasks[query] = asyncio.create_task(search.run(query, fetch))
+                await started[query].wait()
+
+            for query in completion_order:
+                responses[query].set_result(results[query])
+                await tasks[query]
+                if query == "cat":
+                    self.assertEqual(search.result, latest_result)
+
+            self.assertEqual(
+                search.result,
+                latest_result,
+                "An older response must not replace the latest query's result",
+            )
+        finally:
+            for task in tasks.values():
+                if not task.done():
+                    task.cancel()
+            await asyncio.gather(*tasks.values(), return_exceptions=True)
+
+    async def test_latest_response_arrives_last(self):
+        await self.exercise_response_order(("ca", "cat"), ["cat"])
+
+    async def test_older_response_arrives_last(self):
+        await self.exercise_response_order(("cat", "ca"), ["cat"])
+
+    async def test_older_response_cannot_replace_latest_empty_result(self):
+        await self.exercise_response_order(("cat", "ca"), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
