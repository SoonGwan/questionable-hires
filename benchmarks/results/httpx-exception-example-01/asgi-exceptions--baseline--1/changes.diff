+
+def test_status_code_value_lookup():
+    assert httpx.codes(404) == 404
+
+
+def test_status_code_phrase_lookup():
+    assert httpx.codes["NOT_FOUND"] == 404
+
+
+def test_lowercase_status_code():
+    assert httpx.codes.not_found == 404  # type: ignore
+
+
