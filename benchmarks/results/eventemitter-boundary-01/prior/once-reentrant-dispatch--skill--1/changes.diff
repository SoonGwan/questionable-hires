+/**
+ * Consume one registration without changing an active dispatch's snapshot.
+ *
+ * @param {EventEmitter} emitter The owning emitter.
+ * @param {(String|Symbol)} evt The internal event name.
+ * @param {EE} listener The one-time registration.
+ * @private
+ */
+function consumeOnce(emitter, evt, listener) {
+  // Mark before invoking user code so overlapping dispatches share the state.
+  listener.fired = true;
+
+  var listeners = emitter._events[evt];
+  if (listeners === listener) clearEvent(emitter, evt);
+  else if (listeners && !listeners.fn) {
+    for (var i = 0, events = [], length = listeners.length; i < length; i++) {
+      if (listeners[i] !== listener) events.push(listeners[i]);
+    }
+
+    if (events.length) emitter._events[evt] = events.length === 1 ? events[0] : events;
+    else clearEvent(emitter, evt);
+  }
+}
