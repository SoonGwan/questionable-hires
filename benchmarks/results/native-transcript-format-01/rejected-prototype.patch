@@ -619,13 +619,45 @@ def audit_batch(root, spec, python=sys.executable, timeout=30):
                 limitation='Shared successful baseline is one observation, not repeated evidence; external state and flakiness are not controlled.')
 
 
+
+def transcript(result):
+    """Separate native text from its metadata without changing observations."""
+    sections = []
+
+    def observation(value, prefix):
+        copy = dict(value)
+        checks = {}
+        for name, check in value.get('checks', {}).items():
+            checks[name] = dict(check)
+            if isinstance(check.get('output'), str):
+                pointer = prefix + '/checks/' + name
+                output = check['output']
+                sections.append((pointer, output))
+                checks[name]['output'] = dict(transcript_section=pointer, characters=len(output))
+        if 'checks' in value:
+            copy['checks'] = checks
+        return copy
+
+    if 'audits' in result:
+        metadata = dict(result, audits=[observation(value, '#/audits/' + str(index))
+                                       for index, value in enumerate(result['audits'])])
+    else:
+        metadata = observation(result, '#')
+    parts = ['AUDIT METADATA', json.dumps(metadata, separators=(',', ':'))]
+    for pointer, output in sections:
+        parts.extend(['NATIVE OUTPUT ' + pointer, output, 'END NATIVE OUTPUT ' + pointer])
+    return '\n'.join(parts)
+
+
