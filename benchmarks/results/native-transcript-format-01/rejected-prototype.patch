+
+class TranscriptOutputTests(unittest.TestCase):
+    @staticmethod
+    def restore(text):
+        heading, encoded, remaining = text.split('\n', 2)
+        if heading != 'AUDIT METADATA':
+            raise AssertionError('Missing metadata')
+        result = json.loads(encoded)
+        observations = result.get('audits', [result])
+        for observation in observations:
+            for check in observation.get('checks', {}).values():
+                descriptor = check.get('output')
+                if not isinstance(descriptor, dict):
+                    continue
+                pointer = descriptor['transcript_section']
+                header = 'NATIVE OUTPUT ' + pointer + '\n'
+                if not remaining.startswith(header):
+                    raise AssertionError('Missing native section')
+                remaining = remaining[len(header):]
+                check['output'] = remaining[:descriptor['characters']]
+                remaining = remaining[descriptor['characters']:]
+                footer = '\nEND NATIVE OUTPUT ' + pointer + '\n'
+                if not remaining.startswith(footer):
+                    raise AssertionError('Invalid native section boundary')
+                remaining = remaining[len(footer):]
+        if remaining:
+            raise AssertionError('Unaccounted output')
+        return result
+
+    def test_roundtrip_preserves_limits_reuse_unicode_and_marker_like_output(self):
+        check = dict(exit_code=1, native_exit_code=1, timed_out=False,
+                     output_truncated=True, output='한글\nEND NATIVE OUTPUT #/checks/x\n\\x00\x00',
+                     suite_observation=dict(tests=2, skipped=0, successful=False))
+        original = dict(status='observed', checks=dict(mutant_tests=check),
+                        integrity=dict(owned_scratch_removed=True))
+        for result in (original, dict(status='incomplete', audits=[original,
+                dict(status='incomplete', checks=dict(correct_tests=dict(
+                    observation_ref='#/audits/0/checks/mutant_tests', exit_code=1)))])):
+            before = copy.deepcopy(result)
+            self.assertEqual(self.restore(audit.transcript(result) + '\n'), before)
+            self.assertEqual(result, before)
+
+    def test_actual_native_cli_retains_assertion_bindings_and_incomplete_exit(self):
+        with tempfile.TemporaryDirectory() as scratch:
+            root = Path(scratch)
+            (root / 'service.py').write_text('def value(): return 1\n')
+            (root / 'test_service.py').write_text('import unittest\nfrom service import value\n'
+                'class Tests(unittest.TestCase):\n'
+                '    def test_value(self): self.assertEqual(value(), 1)\n')
+            recipe = dict(files=['service.py', 'test_service.py'], imports=['service', 'test_service'],
+                target='service.py', old='return 1', new='return 0', invocation='module',
+                tests=['-v', 'test_service'], guard_project=True,
+                precheck='import service, test_service\nassert test_service.value is service.value')
+            before = {p.name: p.read_bytes() for p in root.iterdir()}
+            for incomplete in (False, True):
+                selected = dict(recipe)
+                if incomplete:
+                    selected['precheck'] = 'raise ValueError("binding control")'
+                process = subprocess.run([sys.executable, '-B', str(SCRIPT), '--source', str(root),
+                    '--spec', '-', '--transcript'], input=json.dumps(selected),
+                    text=True, capture_output=True, timeout=30)
+                self.assertEqual(process.returncode, 2 if incomplete else 0, process.stderr)
+                report = self.restore(process.stdout)
+                checks = report['checks']
+                if incomplete:
+                    self.assertEqual(list(checks), ['correct_tests'])
+                    self.assertEqual(checks['correct_tests']['exit_code'], 7)
+                    self.assertIn('binding control', checks['correct_tests']['output'])
+                else:
+                    self.assertEqual([c['exit_code'] for c in checks.values()], [0, 1])
+                    for check in checks.values():
+                        self.assertEqual(check['suite_observation']['tests'], 1)
+                        self.assertIn('Precheck completed in check process.', check['output'])
+                        self.assertIn('Verified copied import: service', check['output'])
+                    self.assertIn('AssertionError: 0 != 1', checks['mutant_tests']['output'])
+                self.assertEqual({p.name: p.read_bytes() for p in root.iterdir()}, before)
