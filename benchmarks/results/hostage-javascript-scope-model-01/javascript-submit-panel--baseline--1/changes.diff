diff --git a/panel.pending.test.mjs b/panel.pending.test.mjs
new file mode 100644
index 0000000..456d331
--- /dev/null
+++ b/panel.pending.test.mjs
@@ -0,0 +1,174 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { SubmitPanel } from './panel.mjs';
+
+// Deadlines detect regressions without relying on timing to drive saves.
+async function bounded(promise, label) {
+  let timer;
+  try {
+    return await Promise.race([
+      promise,
+      new Promise((_, reject) => {
+        timer = setTimeout(() => reject(new Error(`Timed out: ${label}`)), 2000);
+      }),
+    ]);
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+async function scenario(check) {
+  const gates = [], tasks = [], cleanups = [];
+  const own = {
+    gate() {
+      let resolve, reject;
+      const promise = new Promise((yes, no) => { resolve = yes; reject = no; });
+      // A gate may reject even when a broken panel never invokes its callback.
+      promise.catch(() => {});
+      const gate = { promise, resolve, reject };
+      gates.push(gate);
+      return gate;
+    },
+    track(promise) {
+      // Attach both handlers immediately, including for synchronous save errors.
+      const outcome = promise.then(
+        value => ({ status: 'fulfilled', value }),
+        reason => ({ status: 'rejected', reason }),
+      );
+      tasks.push(outcome);
+      return outcome;
+    },
+    cleanup(fn) { cleanups.push(fn); },
+  };
+  try {
+    await check(own);
+  } finally {
+    // Always release callbacks before draining, even after a failed assertion.
+    for (const gate of gates) gate.resolve();
+    try {
+      await bounded(Promise.all(tasks), 'submission cleanup');
+    } finally {
+      for (const cleanup of cleanups) cleanup();
+    }
+  }
+}
+
+async function fulfilled(task, expected) {
+  const outcome = await bounded(task, 'submission fulfillment');
+  assert.equal(outcome.status, 'fulfilled');
+  assert.equal(outcome.value, expected);
+}
+
+async function rejected(task, expected) {
+  const outcome = await bounded(task, 'submission rejection');
+  assert.equal(outcome.status, 'rejected');
+  assert.equal(outcome.reason, expected);
+}
+
+async function retry(panel, own) {
+  const gate = own.gate(), result = {};
+  let calls = 0;
+  const task = own.track(panel.submit(() => { calls++; return gate.promise; }));
+  assert.equal(calls, 1);
+  assert.equal(panel.pending, true);
+  gate.resolve(result);
+  await fulfilled(task, result);
+  assert.equal(panel.pending, false);
+}
+
+test('pending spans save, suppresses overlaps promptly, and clears for reuse', () => scenario(async own => {
+  const panel = new SubmitPanel(), gate = own.gate();
+  const signal = new AbortController().signal, result = {};
+  assert.equal(panel.pending, false);
+  let calls = 0, receivedSignal, pendingInSave;
+  const task = own.track(panel.submit(received => {
+    calls++;
+    receivedSignal = received;
+    pendingInSave = panel.pending;
+    return gate.promise;
+  }, signal));
+  assert.equal(calls, 1);
+  assert.equal(pendingInSave, true);
+  assert.equal(panel.pending, true);
+  assert.equal(receivedSignal, signal);
+
+  let duplicates = 0;
+  for (let i = 0; i < 2; i++) {
+    const duplicate = own.track(panel.submit(() => { duplicates++; return {}; }));
+    // The original callback remains unsettled while the duplicate must finish.
+    await fulfilled(duplicate, undefined);
+    assert.equal(duplicates, 0);
+    assert.equal(panel.pending, true);
+  }
+  gate.resolve(result);
+  await fulfilled(task, result);
+  assert.equal(panel.pending, false);
+  await retry(panel, own);
+}));
+
+test('different panel instances save concurrently and clear independently', () => scenario(async own => {
+  const first = new SubmitPanel(), second = new SubmitPanel();
+  const firstGate = own.gate(), secondGate = own.gate();
+  const firstResult = {}, secondResult = {};
+  assert.equal(first.pending, false);
+  assert.equal(second.pending, false);
+  let firstCalls = 0, secondCalls = 0;
+  const firstTask = own.track(first.submit(() => { firstCalls++; return firstGate.promise; }));
+  const secondTask = own.track(second.submit(() => { secondCalls++; return secondGate.promise; }));
+  assert.equal(firstCalls, 1);
+  assert.equal(secondCalls, 1);
+  assert.equal(first.pending, true);
+  assert.equal(second.pending, true);
+  secondGate.resolve(secondResult);
+  await fulfilled(secondTask, secondResult);
+  assert.equal(second.pending, false);
+  assert.equal(first.pending, true);
+  await retry(second, own);
+  assert.equal(first.pending, true);
+  firstGate.resolve(firstResult);
+  await fulfilled(firstTask, firstResult);
+  assert.equal(first.pending, false);
+}));
+
+test('asynchronous save failure preserves reason, clears pending, and permits retry', () => scenario(async own => {
+  const panel = new SubmitPanel(), gate = own.gate(), error = new Error('async failure');
+  const task = own.track(panel.submit(() => gate.promise));
+  assert.equal(panel.pending, true);
+  gate.reject(error);
+  await rejected(task, error);
+  assert.equal(panel.pending, false);
+  await retry(panel, own);
+}));
+
+test('synchronous save failure preserves reason, clears pending, and permits retry', () => scenario(async own => {
+  const panel = new SubmitPanel(), error = new Error('sync failure');
+  let pendingInSave;
+  const task = own.track(panel.submit(() => {
+    pendingInSave = panel.pending;
+    throw error;
+  }));
+  assert.equal(pendingInSave, true);
+  await rejected(task, error);
+  assert.equal(panel.pending, false);
+  await retry(panel, own);
+}));
+
+test('callback rejection on abort preserves reason and allows cleanup and retry', () => scenario(async own => {
+  const panel = new SubmitPanel(), controller = new AbortController(), gate = own.gate();
+  const error = new Error('caller aborted');
+  let receivedSignal;
+  const task = own.track(panel.submit(signal => {
+    receivedSignal = signal;
+    const onAbort = () => gate.reject(signal.reason);
+    signal.addEventListener('abort', onAbort, { once: true });
+    own.cleanup(() => signal.removeEventListener('abort', onAbort));
+    return gate.promise;
+  }, controller.signal));
+  assert.equal(receivedSignal, controller.signal);
+  assert.equal(controller.signal.aborted, false);
+  assert.equal(panel.pending, true);
+  controller.abort(error);
+  await rejected(task, error);
+  assert.equal(panel.pending, false);
+  await retry(panel, own);
+}));
