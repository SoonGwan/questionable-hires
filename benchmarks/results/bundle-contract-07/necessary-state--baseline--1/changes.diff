+++ b/test_form.py
@@ -0,0 +1,185 @@
+import asyncio
+import unittest
+
+from form import Form
+
+
+TIMEOUT = 2
+
+
+class FormTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.tasks = []
+
+    async def asyncTearDown(self):
+        for task in self.tasks:
+            if not task.done():
+                task.cancel()
+        if self.tasks:
+            await asyncio.wait_for(
+                asyncio.gather(*self.tasks, return_exceptions=True), TIMEOUT
+            )
+
+    def start(self, coroutine):
+        task = asyncio.create_task(coroutine)
+        self.tasks.append(task)
+        return task
+
+    async def wait(self, awaitable):
+        return await asyncio.wait_for(awaitable, TIMEOUT)
+
+    async def test_initial_pending_and_success_cleanup(self):
+        form = Form()
+        entered = asyncio.Event()
+        release = asyncio.Event()
+        self.assertIs(form.pending, False)
+
+        async def save():
+            self.assertIs(form.pending, True)
+            entered.set()
+            await release.wait()
+
+        task = self.start(form.submit(save))
+        await self.wait(entered.wait())
+        self.assertIs(form.pending, True)
+        self.assertFalse(task.done())
+        release.set()
+        await self.wait(task)
+        self.assertIs(form.pending, False)
+
+    async def test_overlapping_submissions_do_not_call_save(self):
+        form = Form()
+        entered = asyncio.Event()
+        release = asyncio.Event()
+        calls = 0
+
+        async def save():
+            nonlocal calls
+            calls += 1
+            entered.set()
+            await release.wait()
+
+        def duplicate_save():
+            self.fail("An overlapping submission invoked save")
+
+        task = self.start(form.submit(save))
+        await self.wait(entered.wait())
+        duplicates = [self.start(form.submit(duplicate_save)) for _ in range(3)]
+        for duplicate in duplicates:
+            self.assertIsNone(await self.wait(duplicate))
+        self.assertEqual(calls, 1)
+        self.assertIs(form.pending, True)
+        self.assertFalse(task.done())
+        release.set()
+        await self.wait(task)
+        self.assertIs(form.pending, False)
+
+    async def test_instances_are_independent(self):
+        first, second = Form(), Form()
+        entered = [asyncio.Event(), asyncio.Event()]
+        release = [asyncio.Event(), asyncio.Event()]
+
+        async def save(index):
+            entered[index].set()
+            await release[index].wait()
+
+        first_task = self.start(first.submit(lambda: save(0)))
+        await self.wait(entered[0].wait())
+        self.assertIs(second.pending, False)
+        second_task = self.start(second.submit(lambda: save(1)))
+        await self.wait(entered[1].wait())
+        self.assertIs(first.pending, True)
+        self.assertIs(second.pending, True)
+        release[0].set()
+        await self.wait(first_task)
+        self.assertIs(first.pending, False)
+        self.assertIs(second.pending, True)
+        release[1].set()
+        await self.wait(second_task)
+        self.assertIs(second.pending, False)
+
+    async def test_return_value_identity(self):
+        form = Form()
+        result = object()
+
+        async def save():
+            return result
+
+        self.assertIs(await self.wait(form.submit(save)), result)
+        self.assertIs(form.pending, False)
+
+    async def test_failure_identity_cleanup_and_retry(self):
+        form = Form()
+        error = RuntimeError("save failed")
+        entered = asyncio.Event()
+        release = asyncio.Event()
+
+        async def fail():
+            entered.set()
+            await release.wait()
+            raise error
+
+        task = self.start(form.submit(fail))
+        await self.wait(entered.wait())
+        self.assertIs(form.pending, True)
+        release.set()
+        with self.assertRaises(RuntimeError) as caught:
+            await self.wait(task)
+        self.assertIs(caught.exception, error)
+        self.assertIs(form.pending, False)
+        result = object()
+
+        async def retry():
+            self.assertIs(form.pending, True)
+            return result
+
+        self.assertIs(await self.wait(form.submit(retry)), result)
+        self.assertIs(form.pending, False)
+
+    async def test_synchronous_save_exception_identity_and_cleanup(self):
+        form = Form()
+        error = ValueError("save invocation failed")
+
+        def save():
+            self.assertIs(form.pending, True)
+            raise error
+
+        with self.assertRaises(ValueError) as caught:
+            await self.wait(form.submit(save))
+        self.assertIs(caught.exception, error)
+        self.assertIs(form.pending, False)
+
+    async def test_cancellation_cleanup_and_retry(self):
+        form = Form()
+        entered = asyncio.Event()
+        blocked = asyncio.Event()
+        cleaned = asyncio.Event()
+
+        async def save():
+            entered.set()
+            try:
+                await blocked.wait()
+            finally:
+                cleaned.set()
+
+        task = self.start(form.submit(save))
+        await self.wait(entered.wait())
+        self.assertIs(form.pending, True)
+        task.cancel()
+        with self.assertRaises(asyncio.CancelledError):
+            await self.wait(task)
+        self.assertTrue(task.cancelled())
+        self.assertTrue(cleaned.is_set())
+        self.assertIs(form.pending, False)
+        result = object()
+
+        async def retry():
+            self.assertIs(form.pending, True)
+            return result
+
+        self.assertIs(await self.wait(form.submit(retry)), result)
+        self.assertIs(form.pending, False)
+
+
+if __name__ == "__main__":
+    unittest.main()
