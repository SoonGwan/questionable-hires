diff --git a/apps/reports/exporter.py b/apps/reports/exporter.py
index 16e78a4..bfd8abe 100644
--- a/apps/reports/exporter.py
+++ b/apps/reports/exporter.py
@@ -1,11 +1,21 @@
 from pathlib import Path
+from tempfile import NamedTemporaryFile
 
 
 def write_rows(destination, rows):
     destination = Path(destination)
     count = 0
-    with destination.open("w", encoding="utf-8", newline="") as stream:
-        for row in rows:
-            stream.write(row + "\n")
-            count += 1
+    temporary = None
+    try:
+        with NamedTemporaryFile(
+            mode="w", encoding="utf-8", newline="", dir=destination.parent, delete=False
+        ) as stream:
+            temporary = Path(stream.name)
+            for row in rows:
+                stream.write(row + "\n")
+                count += 1
+        temporary.replace(destination)
+    finally:
+        if temporary is not None:
+            temporary.unlink(missing_ok=True)
     return count
diff --git a/tests/test_export.py b/tests/test_export.py
index 945546c..e3877e4 100644
--- a/tests/test_export.py
+++ b/tests/test_export.py
@@ -17,3 +17,26 @@ class ExportTests(unittest.TestCase):
             path = Path(directory) / "report.txt"
             self.assertEqual(write_rows(path, iter([])), 0)
             self.assertEqual(path.read_bytes(), b"")
+
+    def test_iterator_failure_preserves_destination_and_cleans_up(self):
+        for exists in (True, False):
+            for error_type in (RuntimeError, KeyboardInterrupt):
+                with self.subTest(exists=exists, error_type=error_type):
+                    with tempfile.TemporaryDirectory(dir=Path(__file__).resolve().parents[1]) as directory:
+                        path = Path(directory) / "report.txt"
+                        previous = b"previous\xff\r\n"
+                        if exists:
+                            path.write_bytes(previous)
+                        error = error_type("row iteration failed")
+
+                        def rows():
+                            yield "Ada"
+                            yield "한글"
+                            raise error
+
+                        with self.assertRaises(error_type) as raised:
+                            write_rows(path, rows())
+                        self.assertIs(raised.exception, error)
+                        self.assertEqual(set(Path(directory).iterdir()), {path} if exists else set())
+                        if exists:
+                            self.assertEqual(path.read_bytes(), previous)
