+++ b/test_preview.py
@@ -0,0 +1,241 @@
+import asyncio
+import unittest
+
+from preview import Preview
+
+
+TIMEOUT = 2
+
+
+class ControlledFetch:
+    """Signal invocation and let the test choose the callback's outcome."""
+
+    def __init__(self):
+        self.started = asyncio.Event()
+        self.result = asyncio.get_running_loop().create_future()
+        self.keys = []
+
+    def __call__(self, key):
+        self.keys.append(key)
+        self.started.set()
+        return self.result
+
+
+class PreviewTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.tasks = []
+        self.errors = {}
+        self.addAsyncCleanup(self.clean_up_tasks)
+
+    async def clean_up_tasks(self):
+        for task in self.tasks:
+            if not task.done():
+                task.cancel()
+        if self.tasks:
+            done, pending = await asyncio.wait(self.tasks, timeout=TIMEOUT)
+            for task in done:
+                if not task.cancelled():
+                    task.exception()
+            self.assertFalse(pending, "owned refresh tasks did not stop")
+
+    async def start(self, preview, fetch, key="same-key"):
+        async def invoke():
+            try:
+                return await preview.refresh(key, fetch)
+            except BaseException as error:
+                # Observe refresh's exact exception before Task normalizes
+                # CancelledError on older Python versions.
+                self.errors[asyncio.current_task()] = error
+                raise
+
+        task = asyncio.create_task(invoke())
+        self.tasks.append(task)
+        await asyncio.wait_for(fetch.started.wait(), TIMEOUT)
+        self.assertEqual(fetch.keys, [key])
+        self.assertFalse(task.done())
+        return task
+
+    async def settled(self, task):
+        done, _ = await asyncio.wait({task}, timeout=TIMEOUT)
+        self.assertIn(task, done, "refresh did not settle")
+        return task.result()
+
+    async def seeded(self):
+        preview = Preview()
+        self.assertFalse(preview.pending)
+        self.assertIsNone(preview.value)
+        prior = object()
+
+        async def fetch(key):
+            self.assertEqual(key, "seed")
+            return prior
+
+        self.assertIs(
+            await asyncio.wait_for(preview.refresh("seed", fetch), TIMEOUT), prior
+        )
+        self.assertIs(preview.value, prior)
+        self.assertFalse(preview.pending)
+        return preview, prior
+
+    async def reject(self, task, fetch, outcome):
+        if outcome == "failure":
+            error = RuntimeError("callback failed")
+            fetch.result.set_exception(error)
+            with self.assertRaises(RuntimeError) as raised:
+                await self.settled(task)
+            self.assertIs(raised.exception, error)
+        else:
+            task.cancel("controlled cancellation")
+            with self.assertRaises(asyncio.CancelledError):
+                await self.settled(task)
+            self.assertEqual(
+                self.errors[task].args, ("controlled cancellation",)
+            )
+            self.assertTrue(task.cancelled())
+
+    async def test_success_in_both_completion_orders(self):
+        for latest_first in (False, True):
+            with self.subTest(latest_first=latest_first):
+                preview, prior = await self.seeded()
+                older, latest = ControlledFetch(), ControlledFetch()
+                old_task = await self.start(preview, older)
+                self.assertTrue(preview.pending)
+                self.assertIs(preview.value, prior)
+                new_task = await self.start(preview, latest)
+                self.assertTrue(preview.pending)
+                self.assertIs(preview.value, prior)
+                old_value, new_value = object(), object()
+                if latest_first:
+                    latest.result.set_result(new_value)
+                    self.assertIs(await self.settled(new_task), new_value)
+                    self.assertFalse(preview.pending)
+                    self.assertIs(preview.value, new_value)
+                    self.assertFalse(old_task.done())
+                    older.result.set_result(old_value)
+                    self.assertIs(await self.settled(old_task), old_value)
+                else:
+                    older.result.set_result(old_value)
+                    self.assertIs(await self.settled(old_task), old_value)
+                    self.assertTrue(preview.pending)
+                    self.assertIs(preview.value, prior)
+                    self.assertFalse(new_task.done())
+                    latest.result.set_result(new_value)
+                    self.assertIs(await self.settled(new_task), new_value)
+                self.assertFalse(preview.pending)
+                self.assertIs(preview.value, new_value)
+
+    async def test_earlier_failure_or_cancellation_keeps_latest_pending(self):
+        for outcome in ("failure", "cancellation"):
+            with self.subTest(outcome=outcome):
+                preview, prior = await self.seeded()
+                older, latest = ControlledFetch(), ControlledFetch()
+                old_task = await self.start(preview, older)
+                new_task = await self.start(preview, latest)
+                await self.reject(old_task, older, outcome)
+                self.assertTrue(preview.pending)
+                self.assertIs(preview.value, prior)
+                self.assertFalse(new_task.done())
+                value = object()
+                latest.result.set_result(value)
+                self.assertIs(await self.settled(new_task), value)
+                self.assertIs(preview.value, value)
+                self.assertFalse(preview.pending)
+
+    async def test_latest_failure_or_cancellation_clears_pending_and_allows_retry(self):
+        for outcome in ("failure", "cancellation"):
+            with self.subTest(outcome=outcome):
+                preview, prior = await self.seeded()
+                older, latest = ControlledFetch(), ControlledFetch()
+                old_task = await self.start(preview, older)
+                new_task = await self.start(preview, latest)
+                await self.reject(new_task, latest, outcome)
+                self.assertFalse(preview.pending)
+                self.assertIs(preview.value, prior)
+                self.assertFalse(old_task.done())
+                retry = ControlledFetch()
+                retry_task = await self.start(preview, retry)
+                self.assertTrue(preview.pending)
+                self.assertIs(preview.value, prior)
+                old_value = object()
+                older.result.set_result(old_value)
+                self.assertIs(await self.settled(old_task), old_value)
+                self.assertTrue(preview.pending)
+                self.assertIs(preview.value, prior)
+                value = object()
+                retry.result.set_result(value)
+                self.assertIs(await self.settled(retry_task), value)
+                self.assertFalse(preview.pending)
+                self.assertIs(preview.value, value)
+
+    async def test_synchronous_callback_failure_and_retry(self):
+        preview, prior = await self.seeded()
+        older = ControlledFetch()
+        old_task = await self.start(preview, older)
+        error = ValueError("synchronous failure")
+        keys = []
+
+        def fail(key):
+            keys.append(key)
+            self.assertTrue(preview.pending)
+            self.assertIs(preview.value, prior)
+            raise error
+
+        with self.assertRaises(ValueError) as raised:
+            await asyncio.wait_for(preview.refresh("sync", fail), TIMEOUT)
+        self.assertIs(raised.exception, error)
+        self.assertEqual(keys, ["sync"])
+        self.assertFalse(preview.pending)
+        self.assertIs(preview.value, prior)
+        self.assertFalse(old_task.done())
+        older.result.set_result(object())
+        await self.settled(old_task)
+        self.assertFalse(preview.pending)
+        self.assertIs(preview.value, prior)
+        retry = ControlledFetch()
+        retry_task = await self.start(preview, retry)
+        self.assertTrue(preview.pending)
+        self.assertIs(preview.value, prior)
+        value = object()
+        retry.result.set_result(value)
+        self.assertIs(await self.settled(retry_task), value)
+        self.assertIs(preview.value, value)
+        self.assertFalse(preview.pending)
+
+    async def test_callback_cancelled_error_identity(self):
+        preview, prior = await self.seeded()
+        fetch = ControlledFetch()
+        task = await self.start(preview, fetch)
+        error = asyncio.CancelledError("callback cancellation")
+        fetch.result.set_exception(error)
+        with self.assertRaises(asyncio.CancelledError):
+            await self.settled(task)
+        self.assertIs(self.errors[task], error)
+        self.assertFalse(preview.pending)
+        self.assertIs(preview.value, prior)
+
+    async def test_instances_are_independent(self):
+        first, first_prior = await self.seeded()
+        second, second_prior = await self.seeded()
+        first_fetch, second_fetch = ControlledFetch(), ControlledFetch()
+        first_task = await self.start(first, first_fetch)
+        self.assertFalse(second.pending)
+        self.assertIs(second.value, second_prior)
+        second_task = await self.start(second, second_fetch)
+        self.assertTrue(first.pending)
+        self.assertIs(first.value, first_prior)
+        first_value = object()
+        first_fetch.result.set_result(first_value)
+        self.assertIs(await self.settled(first_task), first_value)
+        self.assertFalse(first.pending)
+        self.assertIs(first.value, first_value)
+        self.assertTrue(second.pending)
+        self.assertIs(second.value, second_prior)
+        await self.reject(second_task, second_fetch, "failure")
+        self.assertFalse(second.pending)
+        self.assertIs(second.value, second_prior)
+        self.assertFalse(first.pending)
+        self.assertIs(first.value, first_value)
+
+
+if __name__ == "__main__":
+    unittest.main()
