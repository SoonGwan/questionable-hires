@@ -1,3 +1,4 @@
+import asyncio
 import unittest
 from search import Search
 
@@ -5,3 +6,83 @@ from search import Search
 class SearchTests(unittest.IsolatedAsyncioTestCase):
     async def test_initial(self):
         self.assertIsNone(Search(None).result)
+
+    async def test_identical_queries_complete_newest_first(self):
+        await self._check_reversed_completions("same", "same")
+
+    async def test_different_queries_complete_newest_first(self):
+        await self._check_reversed_completions("older", "newer")
+
+    async def _check_reversed_completions(self, older_query, newer_query):
+        # Every fetch call gets its own response future, including repeated keys.
+        entries = asyncio.Queue()
+        fetch_keys = []
+        owned_tasks = []
+
+        async def fetch(key):
+            response = asyncio.get_running_loop().create_future()
+            fetch_keys.append(key)
+            entries.put_nowait((key, response))
+            return await response
+
+        search = Search(fetch)
+        displayed = {
+            "items": [{"id": "seed", "details": {"tags": ["saved"]}}],
+            "meta": {"total": 1, "cursor": "seed-cursor"},
+        }
+        older_payload = {
+            "items": [{"id": "older", "details": {"tags": ["stale"]}}],
+            "meta": {"total": 10, "cursor": "older-cursor"},
+        }
+        newest_payload = {
+            "items": [{"id": "newest", "details": {"tags": ["fresh"]}}],
+            "meta": {"total": 20, "cursor": "newest-cursor"},
+        }
+
+        async def submit_and_capture(query):
+            task = asyncio.create_task(search.submit(query))
+            owned_tasks.append(task)
+            key, response = await asyncio.wait_for(entries.get(), timeout=1)
+            self.assertEqual(key, query, "actual fetch key")
+            return task, response
+
+        async def complete(task, response, payload):
+            response.set_result(payload)
+            await asyncio.wait_for(asyncio.shield(task), timeout=1)
+
+        try:
+            # Seed the displayed payload through an actual successful request.
+            seed_task, seed_response = await submit_and_capture("seed")
+            await complete(seed_task, seed_response, displayed)
+            self.assertEqual(search.result, displayed, "seed completion")
+
+            older_task, older_response = await submit_and_capture(older_query)
+            self.assertFalse(older_task.done())
+            self.assertEqual(search.result, displayed, "after older submission")
+
+            newest_task, newest_response = await submit_and_capture(newer_query)
+            self.assertIsNot(older_response, newest_response)
+            self.assertFalse(older_task.done())
+            self.assertFalse(newest_task.done())
+            self.assertEqual(search.result, displayed, "after newest submission")
+            self.assertEqual(fetch_keys, ["seed", older_query, newer_query])
+
+            await complete(newest_task, newest_response, newest_payload)
+            self.assertFalse(older_task.done())
+            self.assertEqual(search.result, newest_payload, "after newest completion")
+
+            await complete(older_task, older_response, older_payload)
+            self.assertEqual(fetch_keys, ["seed", older_query, newer_query])
+            self.assertEqual(
+                search.result, newest_payload,
+                "older completion must not replace the newest complete payload",
+            )
+        finally:
+            # Entry checks and payload assertions can fail with requests pending.
+            # Cancel and retrieve every owned task even on those failure paths.
+            for task in owned_tasks:
+                if not task.done():
+                    task.cancel()
+            await asyncio.wait_for(
+                asyncio.gather(*owned_tasks, return_exceptions=True), timeout=1,
+            )
