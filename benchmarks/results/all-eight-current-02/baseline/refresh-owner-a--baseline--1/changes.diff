@@ -0,0 +1,231 @@
+import asyncio
+import unittest
+
+from preview import Preview
+
+
+TIMEOUT = 2
+
+
+class ControlledFetch:
+    def __init__(self):
+        self.started = asyncio.Event()
+        self.result = asyncio.get_running_loop().create_future()
+        self.keys = []
+
+    async def __call__(self, key):
+        self.keys.append(key)
+        self.started.set()
+        return await self.result
+
+
+class PreviewTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.tasks = []
+
+    async def asyncTearDown(self):
+        for task in self.tasks:
+            if not task.done():
+                task.cancel()
+        if self.tasks:
+            done, pending = await asyncio.wait(self.tasks, timeout=TIMEOUT)
+            # Retrieve exceptions even when an assertion interrupted a test.
+            await asyncio.gather(*done, return_exceptions=True)
+            self.assertFalse(pending, "owned refresh tasks did not stop")
+
+    async def start(self, preview, key):
+        fetch = ControlledFetch()
+        task = asyncio.create_task(preview.refresh(key, fetch))
+        self.tasks.append(task)
+        await asyncio.wait_for(fetch.started.wait(), TIMEOUT)
+        self.assertEqual(fetch.keys, [key])
+        self.assertTrue(preview.pending)
+        return task, fetch
+
+    async def outcome(self, task):
+        done, _ = await asyncio.wait({task}, timeout=TIMEOUT)
+        self.assertIn(task, done, "refresh did not settle")
+        return task.result()
+
+    async def seeded(self):
+        preview = Preview()
+        self.assertFalse(preview.pending)
+        self.assertIsNone(preview.value)
+        prior = object()
+        task, fetch = await self.start(preview, "seed")
+        fetch.result.set_result(prior)
+        self.assertIs(await self.outcome(task), prior)
+        self.assertIs(preview.value, prior)
+        self.assertFalse(preview.pending)
+        return preview, prior
+
+    async def test_both_success_completion_orders(self):
+        for latest_first in (False, True):
+            with self.subTest(latest_first=latest_first):
+                preview, prior = await self.seeded()
+                # Equal keys must still invoke both supplied callbacks.
+                older, old_fetch = await self.start(preview, "same")
+                latest, new_fetch = await self.start(preview, "same")
+                self.assertIs(preview.value, prior)
+                old_value, new_value = object(), object()
+                if latest_first:
+                    new_fetch.result.set_result(new_value)
+                    self.assertIs(await self.outcome(latest), new_value)
+                    self.assertFalse(preview.pending)
+                    self.assertIs(preview.value, new_value)
+                    self.assertFalse(older.done())
+                    old_fetch.result.set_result(old_value)
+                    self.assertIs(await self.outcome(older), old_value)
+                else:
+                    old_fetch.result.set_result(old_value)
+                    self.assertIs(await self.outcome(older), old_value)
+                    self.assertTrue(preview.pending)
+                    self.assertIs(preview.value, prior)
+                    self.assertFalse(latest.done())
+                    new_fetch.result.set_result(new_value)
+                    self.assertIs(await self.outcome(latest), new_value)
+                self.assertFalse(preview.pending)
+                self.assertIs(preview.value, new_value)
+
+    async def test_earlier_failure_or_cancellation_keeps_latest_pending(self):
+        for cancel in (False, True):
+            with self.subTest(cancel=cancel):
+                preview, prior = await self.seeded()
+                older, old_fetch = await self.start(preview, "old")
+                latest, new_fetch = await self.start(preview, "new")
+                error = RuntimeError("older failed")
+                if cancel:
+                    older.cancel()
+                else:
+                    old_fetch.result.set_exception(error)
+                with self.assertRaises(asyncio.CancelledError if cancel else RuntimeError) as caught:
+                    await self.outcome(older)
+                if not cancel:
+                    self.assertIs(caught.exception, error)
+                self.assertTrue(preview.pending)
+                self.assertFalse(latest.done())
+                self.assertIs(preview.value, prior)
+                value = object()
+                new_fetch.result.set_result(value)
+                self.assertIs(await self.outcome(latest), value)
+                self.assertIs(preview.value, value)
+                self.assertFalse(preview.pending)
+
+    async def test_latest_failure_or_cancellation_and_retry(self):
+        for cancel in (False, True):
+            with self.subTest(cancel=cancel):
+                preview, prior = await self.seeded()
+                older, old_fetch = await self.start(preview, "old")
+                latest, new_fetch = await self.start(preview, "new")
+                error = RuntimeError("latest failed")
+                if cancel:
+                    latest.cancel()
+                else:
+                    new_fetch.result.set_exception(error)
+                with self.assertRaises(asyncio.CancelledError if cancel else RuntimeError) as caught:
+                    await self.outcome(latest)
+                if not cancel:
+                    self.assertIs(caught.exception, error)
+                self.assertFalse(preview.pending)
+                self.assertFalse(older.done())
+                self.assertIs(preview.value, prior)
+                retry, retry_fetch = await self.start(preview, "retry")
+                self.assertIs(preview.value, prior)
+                old_value = object()
+                old_fetch.result.set_result(old_value)
+                self.assertIs(await self.outcome(older), old_value)
+                self.assertTrue(preview.pending)
+                self.assertIs(preview.value, prior)
+                value = object()
+                retry_fetch.result.set_result(value)
+                self.assertIs(await self.outcome(retry), value)
+                self.assertIs(preview.value, value)
+                self.assertFalse(preview.pending)
+
+    async def test_synchronous_callback_failure_and_retry(self):
+        preview, prior = await self.seeded()
+        older, old_fetch = await self.start(preview, "old")
+        error = ValueError("synchronous failure")
+        keys = []
+
+        def fail(key):
+            keys.append(key)
+            self.assertTrue(preview.pending)
+            self.assertIs(preview.value, prior)
+            raise error
+
+        task = asyncio.create_task(preview.refresh("sync", fail))
+        self.tasks.append(task)
+        with self.assertRaises(ValueError) as caught:
+            await self.outcome(task)
+        self.assertIs(caught.exception, error)
+        self.assertEqual(keys, ["sync"])
+        self.assertFalse(preview.pending)
+        self.assertIs(preview.value, prior)
+        self.assertFalse(older.done())
+        old_value = object()
+        old_fetch.result.set_result(old_value)
+        self.assertIs(await self.outcome(older), old_value)
+        self.assertIs(preview.value, prior)
+        self.assertFalse(preview.pending)
+        retry, fetch = await self.start(preview, "retry")
+        self.assertIs(preview.value, prior)
+        value = object()
+        fetch.result.set_result(value)
+        self.assertIs(await self.outcome(retry), value)
+        self.assertIs(preview.value, value)
+        self.assertFalse(preview.pending)
+
+    async def test_callback_cancellation_exception_identity(self):
+        preview, prior = await self.seeded()
+        fetch = ControlledFetch()
+
+        async def capture():
+            # Inspect propagation before Task normalizes cancellation on Python 3.9.
+            try:
+                await preview.refresh("cancel", fetch)
+            except asyncio.CancelledError as caught:
+                return caught
+            self.fail("refresh did not propagate cancellation")
+
+        task = asyncio.create_task(capture())
+        self.tasks.append(task)
+        await asyncio.wait_for(fetch.started.wait(), TIMEOUT)
+        self.assertEqual(fetch.keys, ["cancel"])
+        self.assertTrue(preview.pending)
+        error = asyncio.CancelledError("callback cancelled")
+        fetch.result.set_exception(error)
+        self.assertIs(await self.outcome(task), error)
+        self.assertFalse(preview.pending)
+        self.assertIs(preview.value, prior)
+
+    async def test_instances_are_independent(self):
+        first, first_prior = await self.seeded()
+        second, second_prior = await self.seeded()
+        first_task, first_fetch = await self.start(first, "first")
+        second_task, second_fetch = await self.start(second, "second")
+        first_latest, latest_fetch = await self.start(first, "first latest")
+        second_value = object()
+        second_fetch.result.set_result(second_value)
+        self.assertIs(await self.outcome(second_task), second_value)
+        self.assertIs(second.value, second_value)
+        self.assertFalse(second.pending)
+        self.assertTrue(first.pending)
+        self.assertIs(first.value, first_prior)
+        self.assertIsNot(first_prior, second_prior)
+        latest_value = object()
+        latest_fetch.result.set_result(latest_value)
+        self.assertIs(await self.outcome(first_latest), latest_value)
+        self.assertFalse(first.pending)
+        self.assertFalse(first_task.done())
+        old_value = object()
+        first_fetch.result.set_result(old_value)
+        self.assertIs(await self.outcome(first_task), old_value)
+        self.assertIs(first.value, latest_value)
+        self.assertFalse(first.pending)
+        self.assertIs(second.value, second_value)
+        self.assertFalse(second.pending)
+
+
+if __name__ == "__main__":
+    unittest.main()
