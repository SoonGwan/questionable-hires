+++ b/parser-verification-s7pa6g2d/working/settings/parser.py
@@ -0,0 +1,9 @@
+def parse(text):
+    values = {}
+    for line in text.splitlines():
+        line = line.strip()
+        if not line or line.startswith("#"):
+            continue
+        parts = line.split("=", 1)
+        values[parts[0].strip()] = parts[1].strip()
+    return values
