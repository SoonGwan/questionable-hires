diff --git a/parser-verification-s7pa6g2d/head/settings/parser.py b/parser-verification-s7pa6g2d/head/settings/parser.py
new file mode 100644
index 0000000..e396a18
--- /dev/null
+++ b/parser-verification-s7pa6g2d/head/settings/parser.py
@@ -0,0 +1,9 @@
+def parse(text):
+    values = {}
+    for line in text.splitlines():
+        line = line.strip()
+        if not line or line.startswith("#"):
+            continue
+        parts = line.split("=")
+        values[parts[0].strip()] = parts[1].strip()
+    return values
