+@pytest.mark.parametrize("runxfail", [False, True])
+@pytest.mark.parametrize(
+    "mark, reason",
+    [
+        ("skip", "unconditional skip"),
+        ('skip(reason="skip reason")', "skip reason"),
+        ('skipif(True, reason="skipif reason")', "skipif reason"),
+    ],
+)
+def test_skip_location(testdir, runxfail, mark, reason):
+    testdir.makepyfile(
+        test_skip_location="""
+        import pytest
+        @pytest.mark.{mark}
+        def test_skip():
+            assert 0
+        """.format(mark=mark)
+    )
+    args = ["-rs"]
+    if runxfail:
+        args.append("--runxfail")
+    result = testdir.runpytest(*args)
+    result.assert_outcomes(skipped=1)
+    result.stdout.fnmatch_lines(["SKIPPED [1] test_skip_location.py:2: " + reason])
+    assert result.ret == 0
+
